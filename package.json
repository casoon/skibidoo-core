{
  "name": "@skibidoo/core",
  "version": "0.1.0",
  "description": "Skibidoo e-commerce core - API, Worker, Scheduler",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./trpc": {
      "types": "./src/trpc/index.ts",
      "import": "./dist/trpc/index.js"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts src/trpc/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:run": "bun test",
    "test:integration": "bun test --config vitest.integration.config.ts",
    "test:all": "bun test && bun test --config vitest.integration.config.ts",
    "test:coverage": "bun test --coverage",
    "lint": "bunx eslint src/",
    "typecheck": "bunx tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "seed:admin": "bun run src/scripts/seed-admin.ts",
    "seed:products": "bun run src/scripts/seed-products.ts",
    "seed:demo": "bun run src/scripts/seed-products.ts && bun run src/scripts/seed-demo-data.ts",
    "secretlint": "secretlint \"**/*\"",
    "prepare": "simple-git-hooks"
  },
  "keywords": [
    "skibidoo",
    "ecommerce",
    "api",
    "hono",
    "bun"
  ],
  "author": "casoon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casoon/skibidoo-core.git"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1029.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/trpc-server": "^0.4.2",
    "@hono/zod-openapi": "^1.2.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/instrumentation-ioredis": "^0.62.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@paypal/paypal-server-sdk": "^2.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@trpc/server": "^11.16.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.73.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.10.1",
    "jimp": "^1.6.1",
    "jose": "^6.2.2",
    "mjml": "^4.18.0",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "stripe": "^22.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^11.6.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bun": "latest",
    "@types/mjml": "^4.7.4",
    "@types/pdfkit": "^0.17.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "secretlint": "^11.6.0",
    "simple-git-hooks": "^2.13.1",
    "testcontainers": "^11.14.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "simple-git-hooks": {
    "pre-commit": "sh -c 'FILES=$(git diff --cached --name-only --diff-filter=ACMR); [ -z \"$FILES\" ] && exit 0; npx secretlint $FILES'"
  }
}
